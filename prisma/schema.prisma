generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  phone       String?  @unique
  role        String   @default("citoyen")
  status      String   @default("actif")
  commune     String?
  avatar      String?
  badgeTitle  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  incidents   Incident[]
  comments    Comment[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  icon        String?
  color       String?
  count       Int       @default(0)
  description String?
  incidents   Incident[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Incident {
  id              String    @id @default(cuid())
  reference       String    @unique
  title           String
  description     String
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  urgency         String    @default("Moyenne")
  status          String    @default("En attente")
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  locationCommune String?
  photoUrl        String?
  reporterId      String?
  reporter        User?     @relation(fields: [reporterId], references: [id])
  agentAssignedId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]
  notifications   Notification[]
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  incidentId String
  incident  Incident @relation(fields: [incidentId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String?
  incidentId String?
  incident  Incident? @relation(fields: [incidentId], references: [id])
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sender    String
  text      String
  avatar    String?
  timestamp String?
  createdAt DateTime @default(now())
}
